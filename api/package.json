{
  "name": "aide-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply aide --local && wrangler dev --local --port 8790 --ip 127.0.0.1",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply aide --local",
    "db:migrate:remote": "wrangler d1 migrations apply aide --remote",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.0.0"
  }
}
