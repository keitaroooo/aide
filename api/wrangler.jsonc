{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aide-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aide",
      "database_id": "869c7630-0e67-4f5b-b3f9-076c14042cb5",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ALLOW_DEV_LOGIN": "true",
    "APP_URL": "https://aide-1ll.pages.dev",
    "OWNER_EMAIL": "keitaro.cryptocurrency@gmail.com"
  }
}
