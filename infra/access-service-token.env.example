# Copy values from terraform output (do not commit real secrets).
#   cd infra/terraform/cloudflare
#   terraform output -raw aide_import_service_token_client_id
#   terraform output -raw aide_import_service_token_client_secret
#
# Used by keitaro-yamaguchi import scripts as HTTP headers:
#   CF-Access-Client-Id / CF-Access-Client-Secret

export CF_ACCESS_CLIENT_ID='paste-client-id'
export CF_ACCESS_CLIENT_SECRET='paste-client-secret'
